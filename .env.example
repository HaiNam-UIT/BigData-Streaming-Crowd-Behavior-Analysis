# Copy file này thành .env và điền giá trị thật.
# Không commit .env lên git.

# ---- Site / session ----
SITE_ID=PLAZA_01
DEFAULT_SESSION_ID=S01

# ---- Path ----
# Đường dẫn nguồn video mẫu (relative to repo root)
DEFAULT_VIDEO_PATH=data/raw/sample.mp4

# ---- YOLO / detection ----
YOLO_MODEL=yolo11n.pt
YOLO_DEVICE=auto
YOLO_CONF=0.30
YOLO_IOU=0.50
YOLO_IMGSZ=960

# ---- Tracking ----
TRACKER=bytetrack.yaml
ENABLE_TRACKING=true

# ---- Video sampling ----
SAMPLE_FPS=5.0
RESIZE_WIDTH=960

# ---- Kafka (P6, chưa dùng cho P2) ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_CAMERA_METRICS=camera-metrics
KAFKA_TOPIC_ZONE_CROSSINGS=zone-crossings
KAFKA_TOPIC_ZONE_STATE=zone-state
KAFKA_TOPIC_EDGE_FLOW=edge-flow
KAFKA_TOPIC_ZONE_FORECASTS=zone-forecasts
KAFKA_TOPIC_EDGE_FORECASTS=edge-forecasts
KAFKA_TOPIC_CONGESTION_ALERTS=congestion-alerts

# ---- PostgreSQL (P6-P7, chưa dùng cho P2) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=plaza
POSTGRES_USER=plaza
POSTGRES_PASSWORD=change-me

# ---- Spark (P6, chưa dùng cho P2) ----
SPARK_MASTER=local[*]
SPARK_CHECKPOINT_DIR=artifacts/runs/checkpoints

# ---- Alert thresholds (tùy chọn; hiệu chuẩn theo zone) ----
ALERT_ZONE_CAPACITY_DEFAULT=200
ALERT_ZONE_DENSITY_DEFAULT=1.5
ALERT_ZONE_SPEED_DEFAULT=0.5

# ---- Logging ----
LOG_LEVEL=INFO
