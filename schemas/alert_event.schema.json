{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://se363.local/schemas/alert_event.schema.json",
  "title": "AlertEvent",
  "description": "Cảnh báo theo rule engine (§14). Ngưỡng theo zone; cảnh báo là tín hiệu hỗ trợ xác minh. Dùng cho topic `congestion-alerts` và bảng alerts.",
  "type": "object",
  "required": [
    "alert_id", "site_id", "zone_id", "timestamp",
    "alert_type", "severity", "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "alert_id": {
      "type": "string",
      "description": "UUID hoặc hash ổn định, để dedupe khi replay."
    },
    "site_id": { "type": "string", "minLength": 1 },
    "zone_id": { "type": "string", "minLength": 1 },
    "edge_id": {
      "type": ["string", "null"],
      "description": "Nếu alert gắn với một edge cụ thể."
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "alert_type": {
      "type": "string",
      "enum": ["PREDICTED_HIGH_OCCUPANCY", "POSSIBLE_CONGESTION", "HIGH_INFLOW_LOW_OUTFLOW", "CAMERA_OFFLINE"]
    },
    "severity": {
      "type": "string",
      "enum": ["info", "warning", "critical"]
    },
    "evidence": {
      "type": "object",
      "description": "Giá trị đo được tại thời điểm alert, để người vận hành xác minh.",
      "required": ["metric", "value", "threshold"],
      "additionalProperties": true,
      "properties": {
        "metric": {
          "type": "string",
          "description": "occupancy | density | avg_speed_mps | inflow_rate | predicted_occupancy",
          "examples": ["predicted_occupancy", "density", "avg_speed_mps"]
        },
        "value": { "type": "number" },
        "threshold": { "type": "number" },
        "horizon_minutes": {
          "type": ["integer", "null"],
          "enum": [null, 1, 3, 5],
          "description": "Horizon của dự báo nếu alert đến từ forecast."
        },
        "windows_persisted": {
          "type": ["integer", "null"],
          "description": "Số window liên tiếp điều kiện đúng; dùng cho rule cần persistence."
        }
      }
    },
    "rule_id": {
      "type": "string",
      "description": "ID rule trong configs/alert_rules.yaml, ví dụ congestion_density_speed."
    },
    "message": { "type": ["string", "null"] }
  }
}
